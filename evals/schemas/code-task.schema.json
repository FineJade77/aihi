{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aihi.dev/schemas/code-task.v1.json",
  "title": "AIHI Coding Agent benchmark task",
  "description": "A deterministic task specification for aihi-code-agent execution in an isolated workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "category", "prompt", "fixture", "limits", "oracle"],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug_fix",
        "feature",
        "test_repair",
        "refactor",
        "repository_understanding",
        "instruction_following",
        "security_boundary",
        "interrupt_resume",
        "subagent"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_turns", "max_tokens"],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_commands", "allowed_paths", "forbidden_paths", "require_clean_regression"],
      "properties": {
        "test_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "require_clean_regression": {
          "type": "boolean"
        },
        "expected_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sandbox_backend": {
          "const": "docker"
        },
        "network": {
          "const": false
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
